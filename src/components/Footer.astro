---
import { INSTAGRAM_URL, WHATSAPP_URL, ZONA } from '../consts';

const year = new Date().getFullYear();
---

<footer class="bg-seco-navy text-white/70">
  <div class="mx-auto max-w-6xl px-4 py-10 md:px-6">
    <div
      class="flex flex-col items-center gap-5 text-center md:flex-row md:justify-between md:gap-4 md:text-left"
    >
      <div class="text-sm font-medium text-white/80">
        Seco24 — Trabajo listo en 24 horas.
      </div>

      <nav class="flex items-center gap-7" aria-label="Redes y contacto">
        <a
          href={INSTAGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-loc="footer"
          class="text-sm font-medium transition-colors hover:text-white"
        >
          Instagram
        </a>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-loc="footer"
          class="text-sm font-medium transition-colors hover:text-white"
        >
          WhatsApp
        </a>
      </nav>

      <div class="text-xs text-white/50">© {year} Seco24 · {ZONA}</div>
    </div>
  </div>
</footer>

---
import CtaWhatsApp from './CtaWhatsApp.astro';
import { INSTAGRAM_URL, INSTAGRAM_USER } from '../consts';
---

<section id="contacto" class="scroll-mt-24 px-4 py-20 text-center md:px-6 md:py-28">
  <div class="mx-auto max-w-3xl">
    <h2
      class="font-display text-4xl font-black tracking-tight text-seco-dark sm:text-[42px]"
    >
      Trabajamos en zonas de Montevideo y Canelones
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-seco-gray">
      ¿Tenés una pared con humedad? Mandanos una foto por WhatsApp y te pasamos un
      presupuesto sin compromiso.
    </p>

    <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <CtaWhatsApp label="Escribinos por WhatsApp" loc="contacto" />
      <a
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full px-8 py-4 text-base font-bold text-seco-blue ring-2 ring-seco-blue transition-colors hover:bg-seco-blue/5"
      >
        @{INSTAGRAM_USER}
      </a>
    </div>
  </div>
</section>

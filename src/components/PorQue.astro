---
const beneficios = [
  {
    titulo: 'Chau manchas.',
    texto:
      'La placa cubre la pared dañada por completo: no se traslucen manchas ni globos de pintura.',
  },
  {
    titulo: 'Sin obra húmeda.',
    texto:
      'No hay que picar paredes ni convivir con escombros. Es un trabajo limpio.',
  },
  {
    titulo: 'Rápido de verdad.',
    texto: 'En 24 horas tenés el ambiente pronto para volver a usar.',
  },
  {
    titulo: 'Queda mejor que antes.',
    texto:
      'No solo solucionás un problema: tu pared gana diseño y textura.',
  },
];
---

<section class="px-4 pb-8 md:px-6 md:pb-12">
  <div class="mx-auto max-w-6xl">
    <div class="rounded-[32px] bg-seco-blue p-10 md:p-16">
      <h2
        class="font-display text-3xl font-black tracking-tight text-white sm:text-4xl"
      >
        ¿Por qué placas y no pintura antihumedad?
      </h2>

      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          beneficios.map((b) => (
            <div>
              <h3 class="text-lg font-bold text-white">{b.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/75">{b.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

---
const beneficios = [
  {
    titulo: 'Chau manchas',
    texto:
      'La placa cubre la pared dañada por completo: no se traslucen manchas ni globos de pintura.',
    path: 'M9 12l2 2 4-4 M12 3a9 9 0 100 18 9 9 0 000-18z',
  },
  {
    titulo: 'Sin obra húmeda',
    texto:
      'No hay que picar paredes ni convivir con escombros. Es un trabajo limpio.',
    path: 'M20 7L9 18l-5-5 M14 4l6 6',
  },
  {
    titulo: 'Rápido de verdad',
    texto: 'En 24 horas tenés el ambiente pronto para volver a usar.',
    path: 'M13 2L4.5 12.5a.5.5 0 00.4.8H11l-1 8.7 8.5-11a.5.5 0 00-.4-.8H12l1-8.2z',
  },
  {
    titulo: 'Queda mejor que antes',
    texto:
      'No solo solucionás un problema: tu pared gana diseño y textura.',
    path: 'M12 3l2.5 5.5L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5L12 3z',
  },
];
---

<section class="bg-seco-blue-ice py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-seco-dark sm:text-4xl">
        ¿Por qué placas y no pintura antihumedad?
      </h2>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        beneficios.map((b) => (
          <div class="flex gap-4 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-100">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-seco-blue/10 text-seco-blue">
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={b.path} />
              </svg>
            </span>
            <div>
              <h3 class="text-lg font-bold text-seco-dark">{b.titulo}</h3>
              <p class="mt-1 text-sm leading-relaxed text-seco-gray">{b.texto}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

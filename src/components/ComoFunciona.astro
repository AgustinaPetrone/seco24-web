---
const pasos = [
  {
    n: '01',
    titulo: 'Mandanos una foto.',
    texto: 'Escribinos por WhatsApp con una foto de tu pared con humedad.',
  },
  {
    n: '02',
    titulo: 'Coordinamos la visita.',
    texto:
      'Vamos, evaluamos la pared y te pasamos un presupuesto sin compromiso.',
  },
  {
    n: '03',
    titulo: 'Colocamos las placas.',
    texto: 'Elegís el diseño que más te guste y hacemos el trabajo.',
  },
  {
    n: '04',
    titulo: 'Listo en 24 horas.',
    texto:
      'Tu pared queda seca, renovada y sin rastros de humedad a la vista.',
  },
];
---

<section id="como-funciona" class="scroll-mt-24 bg-seco-blue-ice py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <h2
      class="text-center font-display text-4xl font-black tracking-tight text-seco-dark sm:text-[42px]"
    >
      Así de simple
    </h2>

    <ol class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        pasos.map((p) => (
          <li class="rounded-[20px] bg-white p-8 shadow-[0_12px_30px_-18px_rgba(19,33,140,0.25)]">
            <div class="font-display text-5xl font-black text-seco-blue/20">
              {p.n}
            </div>
            <h3 class="mt-4 text-lg font-bold text-seco-dark">{p.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-seco-gray">{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

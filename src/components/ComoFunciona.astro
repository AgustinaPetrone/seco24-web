---
const pasos = [
  {
    n: 1,
    titulo: 'Mandanos una foto',
    texto: 'Escribinos por WhatsApp con una foto de tu pared con humedad.',
    icon: 'camera',
  },
  {
    n: 2,
    titulo: 'Coordinamos la visita',
    texto:
      'Vamos, evaluamos la pared y te pasamos un presupuesto sin compromiso.',
    icon: 'calendar',
  },
  {
    n: 3,
    titulo: 'Colocamos las placas',
    texto: 'Elegís el diseño que más te guste y hacemos el trabajo.',
    icon: 'wall',
  },
  {
    n: 4,
    titulo: 'Listo en 24 horas',
    texto:
      'Tu pared queda seca, renovada y sin rastros de humedad a la vista.',
    icon: 'clock',
  },
];

const paths: Record<string, string> = {
  camera:
    'M4 8h3l1.5-2h7L17 8h3a1 1 0 011 1v9a1 1 0 01-1 1H4a1 1 0 01-1-1V9a1 1 0 011-1z M12 17a3.5 3.5 0 100-7 3.5 3.5 0 000 7z',
  calendar:
    'M7 3v3M17 3v3M4 8h16M5 6h14a1 1 0 011 1v12a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1z',
  wall: 'M4 5h16v14H4z M4 9.5h16 M4 14.5h16 M10 5v4.5 M15 9.5v5 M8 14.5V19',
  clock: 'M12 8v4l3 2 M12 3v0M4.5 12a7.5 7.5 0 1015 0 7.5 7.5 0 00-15 0z',
};
---

<section id="como-funciona" class="scroll-mt-20 bg-seco-blue-ice py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-seco-dark sm:text-4xl">
        Así de simple
      </h2>
    </div>

    <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        pasos.map((p) => (
          <li class="relative rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-100">
            <div class="mb-4 flex items-center justify-between">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-seco-blue text-white">
                <svg
                  class="h-6 w-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={paths[p.icon]} />
                </svg>
              </span>
              <span class="text-5xl font-extrabold text-seco-blue/15" aria-hidden="true">
                {p.n}
              </span>
            </div>
            <h3 class="text-lg font-bold text-seco-dark">{p.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-seco-gray">{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

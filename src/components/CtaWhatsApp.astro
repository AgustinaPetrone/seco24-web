---
import { WHATSAPP_URL } from '../consts';

interface Props {
  label?: string;
  variant?: 'primary' | 'white';
  class?: string;
}

const {
  label = 'Pedí tu presupuesto por WhatsApp',
  variant = 'primary',
  class: extra = '',
} = Astro.props;

const base =
  'inline-flex items-center justify-center rounded-full px-8 py-4 text-base font-bold transition-transform transition-colors duration-150 hover:-translate-y-0.5 active:translate-y-0';

const variants = {
  primary:
    'bg-seco-blue text-white shadow-[0_16px_32px_-10px_rgba(19,33,140,0.5)] hover:bg-seco-blue-dark',
  white: 'bg-white text-seco-blue shadow-lg hover:bg-seco-blue-ice',
};
---

<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  class={`${base} ${variants[variant]} ${extra}`}
>
  {label}
</a>

---
import CtaWhatsApp from './CtaWhatsApp.astro';
import { ZONA } from '../consts';
---

<section class="relative overflow-hidden">
  <!-- Blobs decorativos difuminados -->
  <div
    class="pointer-events-none absolute -right-40 -top-32 h-[520px] w-[520px] rounded-full blur-2xl"
    style="background: radial-gradient(circle at 30% 30%, #cbd6f6, #e8eefb);"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -left-36 bottom-10 h-96 w-96 rounded-full opacity-70 blur-[60px]"
    style="background: #f1ece4;"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 py-20 md:px-6 md:py-28">
    <div class="max-w-4xl">
      <p
        class="mb-5 text-sm font-bold uppercase tracking-[0.06em] text-seco-blue"
      >
        Placas de yeso antihumedad · {ZONA}
      </p>

      <h1
        class="font-display text-4xl font-black leading-[1.03] tracking-tight text-seco-dark sm:text-5xl md:text-6xl lg:text-[68px]"
      >
        Tu pared con humedad,{' '}<br class="hidden sm:block" />resuelta en{' '}
        <span class="text-seco-blue">24 horas.</span>
      </h1>

      <p class="mt-7 max-w-xl text-lg leading-relaxed text-seco-gray sm:text-xl">
        Colocamos placas de yeso decorativas que cubren y tratan la humedad de tu
        pared. Sin obra, sin escombros, y con un acabado que transforma el ambiente.
      </p>

      <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:items-center">
        <CtaWhatsApp />
        <a
          href="#trabajos"
          class="inline-flex items-center justify-center gap-1.5 px-2 text-base font-bold text-seco-dark transition-colors hover:text-seco-blue"
        >
          Ver trabajos realizados
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

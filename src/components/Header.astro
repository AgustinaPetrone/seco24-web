---
import { Image } from 'astro:assets';
import mark from '../assets/logo/mark.png';
import { WHATSAPP_URL } from '../consts';

const links = [
  { href: '#trabajos', label: 'Trabajos' },
  { href: '#como-funciona', label: 'Cómo funciona' },
  { href: '#disenos', label: 'Diseños' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header
  class="sticky top-0 z-40 border-b border-seco-blue/10 bg-seco-bg/90 backdrop-blur supports-[backdrop-filter]:bg-seco-bg/80"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 md:px-6">
    <a href="#top" class="flex items-center gap-2.5" aria-label="Seco24 - inicio">
      <Image src={mark} alt="" width="52" height="37" class="h-9 w-auto" loading="eager" />
      <span class="font-display text-2xl font-extrabold tracking-tight text-seco-dark"
        >Seco24</span
      >
    </a>

    <nav class="hidden items-center gap-9 md:flex" aria-label="Navegación principal">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-sm font-semibold text-seco-gray transition-colors hover:text-seco-blue"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <a
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full bg-seco-blue px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-seco-blue-dark"
    >
      <span class="hidden sm:inline">Pedir presupuesto</span>
      <span class="sm:hidden">Presupuesto</span>
    </a>
  </div>
</header>

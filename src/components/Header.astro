---
import { Image } from 'astro:assets';
import mark from '../assets/logo/mark.png';
import { WHATSAPP_URL } from '../consts';

const links = [
  { href: '#trabajos', label: 'Trabajos' },
  { href: '#como-funciona', label: 'Cómo funciona' },
  { href: '#disenos', label: 'Diseños' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header
  class="sticky top-0 z-40 border-b border-gray-100 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/80"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href="#top" class="flex items-center gap-2.5" aria-label="Seco24 - inicio">
      <Image src={mark} alt="" width="52" height="37" class="h-9 w-auto" loading="eager" />
      <span class="text-2xl font-extrabold tracking-tight text-seco-blue">Seco24</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegación principal">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-sm font-medium text-seco-gray transition-colors hover:text-seco-blue"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <a
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-lg bg-seco-blue px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-seco-blue-dark"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.887 9.884"
        ></path>
      </svg>
      <span class="hidden sm:inline">Pedí presupuesto</span>
      <span class="sm:hidden">WhatsApp</span>
    </a>
  </div>
</header>

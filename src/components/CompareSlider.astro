---
import { Image } from 'astro:assets';

interface Props {
  antes: ImageMetadata;
  despues: ImageMetadata;
  antesAlt: string;
  despuesAlt: string;
  widths?: number[];
  sizes?: string;
}

const {
  antes,
  despues,
  antesAlt,
  despuesAlt,
  widths = [400, 800, 1200],
  sizes = '(max-width: 768px) 90vw, 700px',
} = Astro.props;
---

<div
  class="cmp group relative select-none overflow-hidden rounded-[28px] shadow-[0_30px_60px_-20px_rgba(19,33,140,0.35)]"
  data-compare
  style="--pos:50%"
>
  <!-- Base: Después (define la altura del contenedor) -->
  <Image
    src={despues}
    alt={despuesAlt}
    widths={widths}
    sizes={sizes}
    class="block h-auto w-full"
    loading="lazy"
    draggable="false"
  />

  <!-- Overlay: Antes (recortado según --pos) -->
  <div
    class="pointer-events-none absolute inset-0"
    style="clip-path: inset(0 calc(100% - var(--pos)) 0 0)"
  >
    <Image
      src={antes}
      alt={antesAlt}
      widths={widths}
      sizes={sizes}
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
      draggable="false"
    />
  </div>

  <!-- Control (mouse, touch y teclado; accesible) -->
  <input
    type="range"
    min="0"
    max="100"
    value="50"
    step="0.1"
    class="cmp-range absolute inset-0 z-20 h-full w-full cursor-ew-resize appearance-none bg-transparent"
    aria-label="Deslizá para comparar la pared antes y después del tratamiento"
  />

  <!-- UI visible (no captura eventos: pasan al range) -->
  <div class="cmp-ui pointer-events-none absolute inset-0 z-10">
    <span
      class="absolute left-4 top-4 rounded-full bg-black/55 px-3.5 py-1.5 text-xs font-bold text-white"
      >Antes</span
    >
    <span
      class="absolute right-4 top-4 rounded-full bg-seco-blue/85 px-3.5 py-1.5 text-xs font-bold text-white"
      >Después</span
    >

    <!-- Línea divisoria -->
    <div
      class="absolute inset-y-0 w-1 -translate-x-1/2 bg-white shadow-[0_0_0_4px_rgba(251,251,254,0.4)]"
      style="left: var(--pos)"
    >
    </div>

    <!-- Handle circular con manija de dos barras -->
    <div
      class="cmp-handle absolute top-1/2 flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white shadow-[0_8px_20px_-6px_rgba(19,33,140,0.5)]"
      style="left: var(--pos)"
    >
      <span class="h-3.5 w-3.5 border-l-2 border-r-2 border-seco-blue"></span>
    </div>
  </div>
</div>

<style>
  /* El range es transparente y ocupa toda la imagen: click/drag en cualquier
     lado mueve la comparación. El thumb da el área de agarre. */
  .cmp-range {
    /* pan-y: en mobile el scroll vertical funciona; el gesto horizontal
       mueve la barra sin pelearse con el scroll de la página */
    touch-action: pan-y;
    margin: 0;
  }
  .cmp-range:focus {
    outline: none;
  }
  .cmp-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    background: transparent;
    cursor: ew-resize;
  }
  .cmp-range::-moz-range-thumb {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    cursor: ew-resize;
  }
  /* Foco por teclado: resaltar el handle */
  .cmp-range:focus-visible ~ .cmp-ui .cmp-handle {
    box-shadow:
      0 0 0 4px rgba(19, 33, 140, 0.55),
      0 10px 15px -3px rgba(0, 0, 0, 0.25);
  }
</style>

<script>
  function initCompare() {
    document
      .querySelectorAll<HTMLElement>('[data-compare]')
      .forEach((root) => {
        if (root.dataset.ready) return;
        const range = root.querySelector<HTMLInputElement>(
          'input[type="range"]',
        );
        if (!range) return;
        root.dataset.ready = '1';
        const update = () => root.style.setProperty('--pos', range.value + '%');
        range.addEventListener('input', update);
        update();
      });
  }
  initCompare();
  document.addEventListener('astro:page-load', initCompare);
</script>

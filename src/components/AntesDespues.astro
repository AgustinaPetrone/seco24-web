---
import CompareSlider from './CompareSlider.astro';
import t1antes from '../assets/trabajos/trabajo1-antes.webp';
import t1despues from '../assets/trabajos/trabajo1-despues.webp';
import t2antes from '../assets/trabajos/trabajo2-antes.webp';
import t2despues from '../assets/trabajos/trabajo2-despues.webp';
---

<section id="trabajos" class="scroll-mt-20 bg-white py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-seco-dark sm:text-4xl">
        El cambio habla por sí solo
      </h2>
      <p class="mt-4 text-lg text-seco-gray">
        Deslizá para ver cómo quedan las paredes que tratamos. Trabajos reales, en
        casas reales.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3 lg:items-start lg:gap-8">
      <div class="lg:col-span-2">
        <CompareSlider
          antes={t1antes}
          despues={t1despues}
          antesAlt="Pared de living con mancha de humedad antes del tratamiento"
          despuesAlt="La misma pared seca y renovada con placas de yeso símil ladrillo"
          sizes="(max-width: 1024px) 90vw, 680px"
        />
      </div>
      <div class="mx-auto w-full max-w-sm lg:max-w-none">
        <CompareSlider
          antes={t2antes}
          despues={t2despues}
          antesAlt="Pared junto a una puerta con humedad antes del tratamiento"
          despuesAlt="La misma pared junto a la puerta, renovada con placas de yeso"
          sizes="(max-width: 1024px) 90vw, 340px"
        />
      </div>
    </div>
  </div>
</section>
